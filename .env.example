# API Ключ провайдера Hydra AI
# Получите ключ в Telegram-боте: https://t.me/HydraAI_Store_bot?start=r_3781184
HYDRA_AI_API_KEY="your_hydra_ai_api_key_here"

# Официальный базовый URL API провайдера Hydra AI в РФ
HYDRA_AI_BASE_URL="https://api.hydraai.ru/v1"

# Используемая модель по умолчанию
HYDRA_AI_MODEL="deepseek-v4-flash"

# Порт и среда выполнения
PORT=8080
NODE_ENV=development

# Настройки лимитов и безопасности ИИ
DEFAULT_USER_CREDITS=10
HYDRA_AI_MAX_TOKENS=1000
MAX_INPUT_LENGTH=500
DATABASE_URL="file:./dev.db"
